# --- Chế độ A: một hộp thư (env phẳng) — bỏ qua nếu dùng file bên dưới ---

# IMAP (đọc thư)
ZIMBRA_IMAP_HOST=
ZIMBRA_IMAP_PORT=993
ZIMBRA_IMAP_USER=
ZIMBRA_IMAP_PASS=
# true | false (để trống: true nếu port 993)
# ZIMBRA_IMAP_SECURE=true

# SMTP (gửi thư)
ZIMBRA_SMTP_HOST=
ZIMBRA_SMTP_PORT=587
ZIMBRA_SMTP_USER=
ZIMBRA_SMTP_PASS=
# true | false (để trống: true nếu port 465)
# ZIMBRA_SMTP_SECURE=false

# Số thư tối đa mỗi lần zimbra_list_messages (mặc định 200, tối đa 1000)
# ZIMBRA_LIST_MAX=500

# --- Chế độ B: nhiều hộp thư — đường dẫn tuyệt đối tới JSON (xem mailboxes.example.json) ---
# Khi set biến này, KHÔNG cần ZIMBRA_IMAP_* / ZIMBRA_SMTP_* trong env.
# ZIMBRA_MAILBOXES_PATH=/Users/ban/.config/zimbra-mcp/mailboxes.json
